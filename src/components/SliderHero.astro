---
import { Image } from 'astro:assets';
import crestUrl from '../images/CREOS-logo.svg?url';
import ForestSpiritLayer from './forest/ForestSpiritLayer.astro';
import homeCraftHero from '../images/home-craft-hero.jpg';
import worksHero from '../images/works-hero-wolf-v2.png';
import nemetonHero from '../images/about-nemeton-hooded.jpg';
---

    <header class="home-hero home-hero-fullscreen" aria-labelledby="home-hero-heading">
      <Image class="home-hero-image is-active" src={homeCraftHero} alt="Hands carving an intricate circular relief from solid wood" widths={[768, 1280, 1774]} sizes="100vw" loading="eager" fetchpriority="high" data-hero-image />
      <Image class="home-hero-image" src={worksHero} alt="A carved wolf relief surrounded by Celtic knotwork" widths={[768, 1280, 1774]} sizes="100vw" loading="lazy" data-hero-image />
      <Image class="home-hero-image" src={nemetonHero} alt="A hooded figure standing among ancient oak trees in a misty nemeton" widths={[768, 1280, 1774]} sizes="100vw" loading="lazy" data-hero-image />
      <div class="home-hero-shade" aria-hidden="true"></div>
      <ForestSpiritLayer />
      <div class="home-hero-content is-active" data-hero-slide>
        <p class="home-hero-eyebrow">WOOD RELIEF ART</p>
        <h1 id="home-hero-heading">Reliefs made from solid wood.</h1>
        <p class="home-hero-lead">
          I create stylised relief pictures, roundels, icons, and charms from solid wood.
        </p>
        <nav class="home-hero-actions" aria-label="Explore the works">
          <a class="home-hero-primary" href="/works">View the works<span class="hero-button-mark" aria-hidden="true"><img src={crestUrl} alt="" /></span></a>
          <a class="home-hero-secondary" href="/about">About me</a>
        </nav>
      </div>
      <div class="home-hero-content" data-hero-slide aria-hidden="true">
        <p class="home-hero-eyebrow">SYMBOLS AND SUBJECTS</p>
        <p class="home-hero-title">Personal symbols in physical form.</p>
        <p class="home-hero-lead">
          My work is inspired by history, Druidry, and ancient Celtic and Slavic mythologies.
        </p>
        <nav class="home-hero-actions" aria-label="Explore the works">
          <a class="home-hero-primary" href="/works">View the works<span class="hero-button-mark" aria-hidden="true"><img src={crestUrl} alt="" /></span></a>
          <a class="home-hero-secondary" href="/articles">Read the articles</a>
        </nav>
      </div>
      <div class="home-hero-content" data-hero-slide aria-hidden="true">
        <p class="home-hero-eyebrow">ABOUT ME</p>
        <p class="home-hero-title">Craft, Druidry, and discovery.</p>
        <p class="home-hero-lead">
          I study and am interested in Druidism, Wyda, and ancient Celtic and Slavic traditions.
        </p>
        <nav class="home-hero-actions" aria-label="About me">
          <a class="home-hero-primary" href="/about">About me<span class="hero-button-mark" aria-hidden="true"><img src={crestUrl} alt="" /></span></a>
          <a class="home-hero-secondary" href="/category/druidism">Druidry articles</a>
        </nav>
      </div>
      <div class="home-hero-controls" aria-label="Hero slides">
        <button class="is-active" type="button" aria-label="Show Works" aria-current="true" data-hero-control></button>
        <button type="button" aria-label="Show Symbols and subjects" data-hero-control></button>
        <button type="button" aria-label="Show About me" data-hero-control></button>
      </div>
    </header>

<script>
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const images = [...hero.querySelectorAll<HTMLElement>('[data-hero-image]')];
    const controls = [...hero.querySelectorAll<HTMLButtonElement>('[data-hero-control]')];
    let activeSlide = 0;
    let rotationTimer: number | undefined;

    const prepareTitle = (slide: HTMLElement) => {
      const title = slide.querySelector<HTMLElement>('h1, .home-hero-title');
      if (!title || title.classList.contains('hero-title-words')) return title;

      const words = title.textContent?.trim().split(/\s+/) ?? [];
      title.textContent = '';
      title.classList.add('hero-title-words');

      words.forEach((word, index) => {
        const wordElement = document.createElement('span');
        wordElement.className = 'hero-title-word';
        wordElement.textContent = word;
        wordElement.style.setProperty('--word-index', String(index));
        title.append(wordElement, document.createTextNode(' '));
      });

      return title;
    };

    const revealTitle = (slide: HTMLElement) => {
      if (reduceMotion.matches) return;

      const title = prepareTitle(slide);
      if (!title) return;

      title.classList.remove('is-revealed');
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          if (slide.classList.contains('is-active')) title.classList.add('is-revealed');
        });
      });
    };

    slides.forEach(prepareTitle);

    const showSlide = (index: number) => {
      activeSlide = index;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      images.forEach((image, imageIndex) => image.classList.toggle('is-active', imageIndex === index));
      revealTitle(slides[index]);
      controls.forEach((control, controlIndex) => {
        const active = controlIndex === index;
        control.classList.toggle('is-active', active);
        control.toggleAttribute('aria-current', active);
      });
    };

    revealTitle(slides[activeSlide]);

    const startRotation = () => {
      if (reduceMotion.matches || slides.length < 2) return;
      window.clearInterval(rotationTimer);
      rotationTimer = window.setInterval(() => showSlide((activeSlide + 1) % slides.length), 8500);
    };

    controls.forEach((control, index) => {
      control.addEventListener('click', () => {
        showSlide(index);
        startRotation();
      });
    });

    startRotation();

    if (!reduceMotion.matches) {
    let framePending = false;

    const updateParallax = () => {
      const bounds = hero.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      if (bounds.bottom > 0 && bounds.top < viewportHeight) {
        const progress = Math.min(
          1,
          Math.max(0, (viewportHeight - bounds.top) / (viewportHeight + bounds.height)),
        );
        const offset = (progress - 0.5) * 110;
        hero.style.setProperty('--parallax-y', `${offset.toFixed(2)}px`);
      }

      framePending = false;
    };

    const requestUpdate = () => {
      if (!framePending) {
        window.requestAnimationFrame(updateParallax);
        framePending = true;
      }
    };

      updateParallax();
      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);
    }
  }
</script>

<style>
  .home-hero.home-hero-fullscreen {
    min-height: 100svh;
    min-height: 100dvh;
    color: #f1eadd;
  }
  .home-hero-fullscreen .home-hero-content {
    width: min(calc(100% - 3rem), 76rem);
    padding: 8rem 0 6rem;
  }
  .home-hero-fullscreen .home-hero-eyebrow {
    margin-bottom: 1rem;
    color: #c3a67e;
    font: 400 .75rem/1.5 var(--font-display);
    letter-spacing: .045em;
  }
  .home-hero-fullscreen :is(h1, .home-hero-title) {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 4.7vw, 5.25rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .home-hero-fullscreen .home-hero-lead {
    max-width: 25rem;
    margin-top: 1.4rem;
    color: #eeeae2;
    font: 400 clamp(.9375rem, 1.05vw, 1.0625rem)/1.5 var(--font-ui);
    text-wrap: pretty;
  }
  .home-hero-fullscreen .home-hero-actions { margin-top: 2rem; gap: 1rem; }
  .home-hero-fullscreen .home-hero-actions a {
    min-height: 46px;
    border-radius: 999px;
    padding: .65rem 1rem;
    font: 400 .8125rem/1.4 var(--font-ui);
    letter-spacing: 0;
    border-color: rgb(236 227 210 / .6);
    transition: background 180ms ease, transform 180ms ease;
  }
  .home-hero-fullscreen .home-hero-primary {
    gap: .45rem;
    background: #d8b88b;
    box-shadow: none;
  }
  .home-hero-fullscreen .home-hero-primary:has(.hero-button-mark) { padding-right: 0; }
  .home-hero-fullscreen .home-hero-primary:hover { background: #e6cba3; }
  .hero-button-mark { display: grid; place-items: center; width: 30px; height: 30px; margin: -.3rem; margin-right: -.35rem; border-radius: 50%; background: transparent; }
  .hero-button-mark img { width: 24px; height: 24px; object-fit: contain; }
  .home-hero-fullscreen .home-hero-shade {
    background: linear-gradient(90deg, rgb(24 21 17 / .88), rgb(24 21 17 / .48) 40%, rgb(24 21 17 / .06) 75%), linear-gradient(0deg, rgb(24 21 17 / .4), transparent 40%);
  }
  .home-hero-fullscreen .home-hero-actions a:focus-visible { outline: 2px solid #e6cba3; outline-offset: 5px; }
  @media (max-width: 640px) {
    .home-hero-fullscreen .home-hero-content { width: calc(100% - 2.5rem); padding: 7rem 0 5rem; }
    .home-hero-fullscreen :is(h1, .home-hero-title) { font-size: clamp(2.5rem, 10vw, 3.5rem); }
    .home-hero-fullscreen .home-hero-lead { max-width: 30ch; }
    .home-hero-fullscreen .home-hero-actions { gap: .75rem; margin-top: 1.5rem; }
    .home-hero-fullscreen .home-hero-shade { background: linear-gradient(0deg, rgb(24 21 17 / .94), rgb(24 21 17 / .68) 45%, rgb(24 21 17 / .1) 100%); }
  }
</style>
