---
import currentLogoUrl from '../images/CREOS-logo-white.svg?url';

interface Props {
  title: string;
  lines?: string[];
  tone?: 'dark' | 'earth' | 'accent';
}

const { title, lines = [], tone = 'dark' } = Astro.props;
---

<header class={`hero hero-${tone}`}>
  <a class="hero-brand" href="/" aria-label="Paul Creos home">
    <img src={currentLogoUrl} alt="" />
  </a>
  <div class="hero-copy">
    <p class="hero-title">{title}</p>
    {lines.map((line) => <p>{line}</p>)}
  </div>
</header>
