---
import ArticleList from './ArticleList.astro';
---

<section class="latest-articles-section" aria-labelledby="latest-articles-title">
  <header class="latest-articles-header">
    <h2 id="latest-articles-title">Latest articles</h2>
  </header>
  <div class="latest-articles-inner">
    <ArticleList compact limit={5} />
    <a class="latest-articles-button" href="/articles">All articles</a>
  </div>
</section>

<style>
  .latest-articles-section {
    color: #fff;
    background: radial-gradient(circle at 15% 15%, rgb(110 137 84 / .24), transparent 27rem), radial-gradient(circle at 86% 80%, rgb(77 106 75 / .2), transparent 25rem), linear-gradient(135deg, #26362c, #1e2c25 65%, #27372d);
  }
  .latest-articles-header {
    display: flex;
    justify-content: center;
    padding: clamp(3rem, 6vw, 6rem) var(--layout-gutter) clamp(1.5rem, 2.5vw, 3rem);
    text-align: center;
  }
  h2 {
    margin: 0;
    color: #fff;
    font: 400 clamp(2rem, 3vw, 3rem)/1.2 var(--font-display);
  }
  .latest-articles-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100% - clamp(2rem, 4vw, 4rem), 60rem);
    margin-inline: auto;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  .latest-articles-inner :global(.article-list--compact) {
    width: 100%;
    gap: 0;
    padding-bottom: 0;
  }
  .latest-articles-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    margin-top: clamp(1.5rem, 2vw, 2rem);
    padding: .65rem 1.15rem;
    border: 1px solid rgb(236 227 210 / .6);
    border-radius: 999px;
    background: #d8b88b;
    color: #1d281f !important;
    font: 400 .9rem/1.35 var(--font-ui) !important;
    letter-spacing: .045em;
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
  }
  .latest-articles-button:hover,
  .latest-articles-button:focus-visible {
    background: #e6cba3;
    color: #1d281f !important;
    transform: translateY(-1px);
  }
</style>
