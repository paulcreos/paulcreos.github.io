---
import Firefly from './Firefly.astro';

interface Props {
  fireflies?: boolean;
  subtle?: boolean;
}

const { fireflies = true, subtle = false } = Astro.props;
---

<div class:list={['forest-spirit-layer', { 'is-subtle': subtle }]} aria-hidden="true">
  {fireflies && (
    <>
      {!subtle && <Firefly profile="curious" />}
      <Firefly profile="distant" />
      <Firefly profile="wanderer" />
    </>
  )}
</div>

<style>
  .forest-spirit-layer.is-subtle { opacity: .65; }
  .forest-spirit-layer {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
</style>

<script>
  import { FireflyController } from './firefly-engine';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const controllers: FireflyController[] = [];

  const stop = () => {
    controllers.forEach((controller) => controller.stop());
    controllers.length = 0;
  };

  const initialize = () => {
    stop();
    if (reduceMotion.matches) return;
    document.querySelectorAll<HTMLElement>('.forest-spirit-layer').forEach((layer) => {
      const habitat = layer.closest<HTMLElement>('.home-hero, .about-hero, .articles-hero, .works-hero, .under-construction');

      layer.querySelectorAll<HTMLElement>('[data-firefly]').forEach((firefly) => {
        if (!habitat) return;

        const requestedProfile = firefly.dataset.fireflyProfile;
        const profile = requestedProfile === 'distant' || requestedProfile === 'wanderer'
          ? requestedProfile
          : 'curious';
        const controller = new FireflyController(firefly, habitat, profile);
        controllers.push(controller);
        controller.start();
      });
    });
  };

  initialize();
  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', stop);
  window.addEventListener('pagehide', stop);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) initialize();
  });
  reduceMotion.addEventListener('change', initialize);
</script>
