---
import { getCollection } from 'astro:content';
import { CATEGORY_META, type Category } from '../data/categories';

interface Props {
  limit?: number;
  category?: Category;
  compact?: boolean;
}

const { limit, category, compact = false } = Astro.props;
let articles = (await getCollection('articles')).filter(
  (article) => !article.data.draft,
);

if (category) {
  articles = articles.filter((article) => article.data.category === category);
}

const sortedArticles = articles
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, limit ?? undefined);
---

<div class:list={['article-list', { 'article-list--compact': compact }]}>
  {sortedArticles.map((article) => {
    const meta = CATEGORY_META[article.data.category];
    const url = `/articles/${article.id}`;

    if (compact) {
      return (
        <article class="article-list-row">
          <a href={`/category/${article.data.category}`} class={`category-badge ${meta.classes}`}>
            {meta.label}
          </a>
          <div class="article-list-row-copy">
            <a class="article-list-row-title" href={url}>{article.data.title}</a>
            <p>{article.data.description}</p>
          </div>
        </article>
      );
    }

    return (
      <article class="article-card">
        <div class="article-card-body">
          <p class="article-card-meta">
            <a
              href={`/category/${article.data.category}`}
              class={`category-badge ${meta.classes}`}
            >
              {meta.label}
            </a>
            <span class="article-card-byline">
              <time datetime={article.data.date.toISOString()}>
                {article.data.date.toLocaleDateString('en-GB')}
              </time>
              {article.data.author && <span> · {article.data.author}</span>}
            </span>
          </p>
          <h2><a href={url}>{article.data.title}</a></h2>
          <p class="article-summary">{article.data.description}</p>
          <p class="read-more">
            <a href={url}>Read article <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </article>
    );
  })}

  {sortedArticles.length === 0 && (
    <p class="empty-state">No articles found.</p>
  )}
</div>

<style>
  .article-list--compact {
    display: flex;
    flex-direction: column;
    width: min(100% - clamp(2rem, 4vw, 4rem), 60rem);
    margin-inline: auto;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  .article-list-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(216 180 142 / .4);
  }
  .article-list-row:first-child {
    border-top: 1px solid rgb(216 180 142 / .4);
  }
  .article-list-row > a,
  .article-list-row > time {
    color: #d8b48e;
    text-decoration: none;
  }
  .article-list-row .category-badge {
    flex: 0 0 6.5rem;
    box-sizing: border-box;
    margin: 0;
    padding: .24rem .7rem;
    border: 1px solid rgb(216 180 142 / .72);
    background: transparent;
    font: 400 .8rem/1.35 var(--font-ui);
    text-align: center;
    text-transform: none;
  }
  .article-list-row-title {
    display: block;
    overflow: hidden;
    color: #d8b48e !important;
    font: 400 clamp(1rem, 1.35vw, 1.35rem)/1.35 var(--font-reading);
    white-space: nowrap;
    text-overflow: ellipsis;
    text-decoration: none;
    transition: color .2s ease, padding-left .2s ease;
  }
  .article-list-row-copy {
    flex: 1 1 auto;
    min-width: 0;
  }
  .article-list-row-copy p {
    margin: .25rem 0 0;
    overflow: hidden;
    color: rgb(236 227 210 / .72);
    font: 400 .85rem/1.4 var(--font-ui);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .article-list-row-title:hover,
  .article-list-row-title:focus-visible {
    color: #fff !important;
    padding-left: .5rem;
  }
  @media (max-width: 40rem) {
    .article-list-row { gap: .6rem; }
    .article-list-row .category-badge { flex-basis: 5.5rem; padding-inline: .35rem; }
  }
</style>
