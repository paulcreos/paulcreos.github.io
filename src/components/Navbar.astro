---
import wordmark from '../images/CREOS-logo-text.svg?url';
import crest from '../images/CREOS-logo-warm.svg?url';
const pathname = Astro.url.pathname;
const items = [
  { href: '/', label: 'Home', active: pathname === '/' },
  { href: '/works', label: 'Works', active: pathname.startsWith('/works') },
  { href: '/articles', label: 'Articles', active: pathname.startsWith('/articles') || pathname.startsWith('/category') },
  { href: '/about', label: 'About', active: pathname.startsWith('/about') },
];
---

<nav class:list={['atelier-nav', { 'atelier-nav-home': pathname === '/' }]} aria-label="Main navigation">
  <span class="atelier-rule" aria-hidden="true"></span>
  <div class="atelier-nav-inner">
    <a class="atelier-brand" href="/" aria-label="Paul Creos home">
      <img class="atelier-crest" src={crest} alt="" />
      <img class="atelier-wordmark" src={wordmark} alt="" />
    </a>
    <button class="atelier-menu" type="button" aria-label="Menu" aria-expanded="false" aria-controls="atelier-links" hidden>
      <svg class="atelier-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
    <ul class="atelier-links" id="atelier-links">
      {items.map((item) => (
        <li><a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </div>
  <span class="atelier-rule" aria-hidden="true"></span>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.atelier-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.atelier-menu');
  const links = nav?.querySelector<HTMLElement>('.atelier-links');
  if (nav && toggle && links) {
    const mobile = window.matchMedia('(max-width: 47.99rem)');
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      links.hidden = mobile.matches;
    };
    const sync = () => {
      const focusWillHide = mobile.matches && links.contains(document.activeElement);
      const toggleHadFocus = document.activeElement === toggle;
      toggle.hidden = !mobile.matches;
      close();
      if (focusWillHide) toggle.focus();
      if (!mobile.matches && toggleHadFocus) links.querySelector('a')?.focus();
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      links.hidden = !open;
    });
    nav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches && !links.hidden) {
        close();
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (mobile.matches && event.target instanceof Node && !nav.contains(event.target)) close();
    });
    links.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) close();
    });
    mobile.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .atelier-nav {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.5rem);
    min-height: 5.5rem;
    background: #201e19;
    color: #eee9df;
  }
  .atelier-nav-home {
    position: absolute;
    inset: 0 0 auto;
    background: linear-gradient(180deg, rgb(12 13 10 / .85), rgb(12 13 10 / .25) 75%, transparent);
  }
  .atelier-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 1 76rem;
    min-width: 0;
    gap: 2rem;
    padding-block: .85rem;
  }
  .atelier-rule {
    position: relative;
    flex: 1 1 1rem;
    height: 1px;
    background: rgb(195 160 111 / .6);
  }
  .atelier-rule::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 3.5355px;
    height: 3.5355px;
    background: #d8b48e;
    content: '';
    transform: translateY(-50%) rotate(45deg);
  }
  .atelier-rule:last-child::after { right: auto; left: 0; }
  .atelier-brand { display: flex; align-items: center; gap: .65rem; flex-shrink: 0; min-height: 44px; }
  .atelier-crest { width: 1.98rem; height: 1.98rem; object-fit: contain; }
  .atelier-wordmark { width: 6.75rem; height: auto; object-fit: contain; }
  .atelier-links { display: flex; align-items: center; flex-wrap: wrap; gap: 0; padding: 0; margin: 0; list-style: none; }
  .atelier-links li { display: flex; align-items: center; }
  .atelier-links li + li::before { content: ''; width: .4rem; height: .4rem; margin-inline: clamp(.5rem, 1.4vw, 1.25rem); background: #d8b48e; transform: rotate(45deg); }
  .atelier-links a { display: flex; align-items: center; position: relative; min-height: 44px; padding: .5rem .2rem; color: #d8b48e; font: 400 .9375rem/1.4 var(--font-ui); text-decoration: none; }
  .atelier-links a::after { content: ''; position: absolute; inset: auto .2rem .35rem; height: 1px; background: currentColor; transform: scaleX(0); transition: transform 180ms ease; }
  .atelier-links a:hover::after, .atelier-links a[aria-current="page"]::after { transform: scaleX(1); }
  .atelier-links a:hover, .atelier-links a[aria-current="page"] { color: #fff; }
  .atelier-menu { display: flex; align-items: center; justify-content: center; gap: .75rem; min-height: 44px; padding: .5rem .75rem; border: 1px solid rgb(195 160 111 / .45); background: transparent; color: #eee9df; font: 400 .9375rem/1.4 var(--font-ui); cursor: pointer; }
  .atelier-menu { min-width: 44px; }
  .atelier-menu-icon { display: block; width: 22px; height: 22px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .atelier-nav :focus-visible { outline: 2px solid #e5c79f; outline-offset: 5px; }
  .atelier-menu[hidden], .atelier-links[hidden] { display: none; }
  @media (max-width: 47.99rem) {
    .atelier-nav { min-height: 4.75rem; padding-inline: clamp(1rem, 4vw, 1.5rem); }
    .atelier-rule { display: none; }
    .atelier-nav-inner { flex: 1; flex-wrap: wrap; gap: .65rem 1rem; padding-block: .6rem; }
    .atelier-crest { width: 1.72rem; height: 1.72rem; }
    .atelier-wordmark { width: 5.85rem; height: auto; }
    .atelier-links { flex-basis: 100%; display: grid; grid-template-columns: minmax(0, 1fr); gap: .25rem 1rem; padding: .75rem; border: 1px solid rgb(195 160 111 / .3); background: #201e19; }
    .atelier-links li + li::before { display: none; }
    .atelier-links a { width: 100%; justify-content: center; text-align: center; padding-inline: .5rem; }
  }
</style>
