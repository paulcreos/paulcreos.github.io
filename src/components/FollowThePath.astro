---
import { Image } from 'astro:assets';
import ravenRelief from '../content/works/images/raven-sigil-cover-v1.png';
import wolfDetail from '../content/works/images/wolf-guardian-macro-v1.png';
import knotworkDetail from '../content/works/images/raven-sigil-knotwork-cover-v1.png';
---

<section class="social-section" aria-labelledby="social-heading">
  <div class="social-heading">
    <p class="eyebrow">Follow the path</p>
    <h2 id="social-heading">Follow my work on Etsy, Instagram, and Pinterest.</h2>
  </div>

  <div class="social-links">
    <a
      class="social-card social-card-primary"
      href="https://paulcreos.etsy.com"
      target="_blank"
      rel="me noopener noreferrer"
    >
      <span class="social-card-media" aria-hidden="true">
        <Image src={ravenRelief} alt="" widths={[480, 720]} sizes="(min-width: 48rem) 16rem, 100vw" />
      </span>
      <span class="social-name">Etsy</span>
      <span class="social-arrow" aria-hidden="true">↗</span>
    </a>

    <a
      class="social-card"
      href="https://www.instagram.com/paulcreos"
      target="_blank"
      rel="me noopener noreferrer"
    >
      <span class="social-card-media" aria-hidden="true">
        <Image src={wolfDetail} alt="" widths={[480, 720]} sizes="(min-width: 48rem) 16rem, 100vw" />
      </span>
      <span class="social-name">Instagram</span>
      <span class="social-arrow" aria-hidden="true">↗</span>
    </a>

    <a
      class="social-card"
      href="https://www.pinterest.com/paulcreos"
      target="_blank"
      rel="me noopener noreferrer"
    >
      <span class="social-card-media" aria-hidden="true">
        <Image src={knotworkDetail} alt="" widths={[480, 720]} sizes="(min-width: 48rem) 16rem, 100vw" />
      </span>
      <span class="social-name">Pinterest</span>
      <span class="social-arrow" aria-hidden="true">↗</span>
    </a>
  </div>

</section>
