---
import crest from '../images/CREOS-logo-warm.svg?url';
import { getCollection } from 'astro:content';
import { CATEGORY_META } from '../data/categories';

const latestArticles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---

<section class="druid-introduction" aria-labelledby="druid-introduction-title" style={`--crest: url(${crest})`}>
  <div class="druid-introduction-copy">
    <h2 id="druid-introduction-title">Imthecht in Druad</h2>
    <span class="druid-introduction-diamond" aria-hidden="true"></span>
    <p>My work grows where inner intent meets matter.<br />Rooted in ancient forms and symbols, each artefact bears<br />witness to a journey between the inner and outer worlds —<br />between silence and the pulse of life.</p>
    <nav class="latest-articles" aria-label="Latest articles">
      {latestArticles.map((article) => {
        const meta = CATEGORY_META[article.data.category];

        return (
          <div class="latest-article-row">
            <a
              href={`/category/${article.data.category}`}
              class={`category-badge ${meta.classes}`}
            >
              {meta.label}
            </a>
            <a href={`/articles/${article.id}`}>{article.data.title}</a>
          </div>
        );
      })}
    </nav>
    <a class="latest-articles-button home-hero-secondary" href="/articles">All articles</a>
  </div>
</section>

<style>
  .druid-introduction {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: clamp(24rem, 68svh, 44rem);
    padding: clamp(4rem, 7vw, 8rem) var(--layout-gutter);
    overflow: hidden;
    color: #fff;
    background: radial-gradient(circle at 15% 15%, rgb(110 137 84 / 0.24), transparent 27rem), radial-gradient(circle at 86% 80%, rgb(77 106 75 / 0.2), transparent 25rem), linear-gradient(135deg, #26362c, #1e2c25 65%, #27372d);
    text-align: center;
  }
  .druid-introduction::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -60% -20%;
    background: #9a9d78;
    opacity: .055;
    mask: var(--crest) center / cover no-repeat;
    transform: rotate(-18deg);
    pointer-events: none;
  }
  .druid-introduction-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 80rem);
    gap: clamp(1.25rem, 1.8vw, 2.25rem);
  }
  h2 {
    margin: 0;
    color: #d8b48e;
    font: 400 clamp(.875rem, 1.1vw, 1.375rem)/1.5 var(--font-ui);
    text-transform: uppercase;
    letter-spacing: .025em;
  }
  .druid-introduction-diamond {
    width: clamp(.625rem, .75vw, .9375rem);
    aspect-ratio: 1;
    flex-shrink: 0;
    background: #d8b48e;
    transform: rotate(45deg);
  }
  p {
    margin: 0;
    font: 400 clamp(1.5rem, 2.55vw, 3.25rem)/1.27 var(--font-reading);
    text-wrap: pretty;
  }
  .latest-articles {
    display: flex;
    flex-direction: column;
    width: min(100%, 60rem);
    margin-top: clamp(2rem, 4vw, 4rem);
    margin-bottom: clamp(1rem, 2vw, 2rem);
    border-top: 1px solid rgb(216 180 142 / .4);
  }
  .latest-articles a {
    color: #d8b48e;
    font: 400 clamp(1rem, 1.35vw, 1.35rem)/1.35 var(--font-reading);
    white-space: nowrap;
    text-decoration: none;
    transition: color .2s ease, padding-left .2s ease;
  }
  .latest-article-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(216 180 142 / .4);
  }
  .latest-article-row .category-badge {
    flex: 0 0 auto;
    width: 6.5rem;
    box-sizing: border-box;
    margin: 0;
    padding: .24rem .7rem;
    border: 1px solid rgb(216 180 142 / .72);
    background: transparent;
    color: #d8b48e;
    font: 400 .8rem/1.35 var(--font-ui);
    letter-spacing: 0;
    text-align: center;
    text-transform: none;
  }
  .latest-article-row a {
    padding: 0;
  }
  .latest-article-row > a:hover,
  .latest-article-row > a:focus-visible {
    padding-left: .5rem;
    color: #fff;
  }
  .latest-articles-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: .65rem 1.15rem;
    border: 1px solid rgb(236 227 210 / .6);
    border-radius: 999px;
    background: #d8b88b;
    color: #1d281f;
    font: 400 .9rem/1.35 var(--font-ui);
    letter-spacing: .045em;
    margin-top: clamp(.5rem, 1vw, 1rem);
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
  }
  .latest-articles-button:hover,
  .latest-articles-button:focus-visible {
    background: #e6cba3;
    color: #1d281f;
    transform: translateY(-1px);
  }
  @media (min-width: 48rem) {
    .druid-introduction {
      min-height: 100svh;
      max-height: none;
    }
  }
  @media (min-width: 120rem) {
    p {
      font-size: clamp(1.5rem, 2.1vw, 2.85rem);
      font-weight: 400;
    }
  }
  @media (max-width: 47.99rem) {
    .druid-introduction { min-height: 35rem; padding-block: 5rem; }
    .druid-introduction::before { inset: -10% -110%; }
    p { line-height: 1.45; }
  }
</style>
