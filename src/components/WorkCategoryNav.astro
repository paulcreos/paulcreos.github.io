---
import { WORK_CATEGORY_KEYS, WORK_CATEGORY_META } from '../data/work-categories';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const allIsActive = pathname === '/works' || pathname === '/';
---

<nav class="category-nav" aria-label="Work categories">
  <a
    href="/works"
    class:list={['category-nav-link', 'category-nav-all', { 'is-active': allIsActive }]}
    aria-current={allIsActive ? 'page' : undefined}
  >All</a>
  <span class="category-nav-separator" aria-hidden="true"></span>
  {WORK_CATEGORY_KEYS.map((category, index) => {
    const isActive = pathname === `/works/category/${category}`;
    const meta = WORK_CATEGORY_META[category];

    return (
      <>
        {category !== 'roundels' ? (
          <span class="category-nav-link is-disabled" role="link" aria-disabled="true">{meta.label}</span>
        ) : (<a
          href={`/works/category/${category}`}
          class:list={['category-nav-link', { 'is-active': isActive }]}
          aria-current={isActive ? 'page' : undefined}
        >{meta.label}</a>)}
        {index < WORK_CATEGORY_KEYS.length - 1 && (
          <span class="category-nav-separator" aria-hidden="true"></span>
        )}
      </>
    );
  })}
</nav>

<style>
  .category-nav .category-nav-link.is-disabled {
    color: #8b9186;
    opacity: .55;
    cursor: default;
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }
</style>
