---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 320 28"
  role="presentation"
  aria-hidden="true"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path class="line" d="M8 16H141M179 16H312" />
    <g transform="translate(160 14) scale(.72) translate(-160 -14)">
      <path class="fern-stem" d="M160 25C160 17 160 10 160 3" />
      <path class="fern-leaves" d="M160 8c-4 0-7-2-9-5M160 11c-5 0-9-2-12-6M160 14c-6 0-10-2-14-5M160 17c-6 1-10 0-13-2M160 8c4 0 7-2 9-5M160 11c5 0 9-2 12-6M160 14c6 0 10-2 14-5M160 17c6 1 10 0 13-2" />
    </g>
  </g>
  <circle cx="8" cy="16" r="1.35" fill="currentColor" />
  <circle cx="312" cy="16" r="1.35" fill="currentColor" />
</svg>

<style>
  svg {
    display: block;
    color: var(--cta-wood);
  }

  .line { opacity: .32; stroke-width: 1; }
  .fern-stem { opacity: .92; stroke-width: 1.1; }
  .fern-leaves { opacity: .82; stroke-width: 1.05; }
</style>
