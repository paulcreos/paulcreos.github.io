---
import Layout from './Layout.astro';
import CelticDivider from '../components/CelticDivider.astro';
import SmallDivider from '../components/SmallDivider.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WorkModelViewer from '../components/WorkModelViewer.astro';
import { SITE } from '../config/site';
import { WORK_AVAILABILITY, type WorkAvailability } from '../data/work-availability';
import { WORK_CATEGORY_META, type WorkCategory } from '../data/work-categories';

const { frontmatter, slug } = Astro.props;
const availability = WORK_AVAILABILITY[frontmatter.availability as WorkAvailability];
const modelBackgrounds: Record<string, string> = {
  'stag-of-the-grove': 'green-mist.webp',
  'the-hearth-rune': 'amber-tree.webp',
  'the-knotkeeper': 'green-knots.webp',
  'the-oak-sentinel': 'brown-wood.webp',
  'the-quiet-flame': 'green-warm.webp',
  'the-raven-sigil': 'stone.webp',
  'the-threshold': 'green-royal.webp',
  'the-wayfinder': 'brown-knots.webp',
  'the-wolf-guardian': 'brown-grunge.webp',
};
const modelBackground = modelBackgrounds[slug] ?? 'brown-grunge.webp';
const workSchema = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: frontmatter.title,
  description: frontmatter.description,
  image: frontmatter.cover?.src,
  creator: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
  },
  artMedium: frontmatter.materials.join(' / '),
  artform: WORK_CATEGORY_META[frontmatter.workCategory as WorkCategory].label,
  dateCreated: (frontmatter.createdDate ?? frontmatter.date).toISOString(),
  url: `${SITE.url}/works/${slug}`,
};
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  canonical={`/works/${slug}`}
  type="article"
  publishedTime={frontmatter.date}
  modifiedTime={frontmatter.updatedDate}
>
  <main id="main-content" class="work-page">
    <article class="article-shell work-shell">
      <header class="article-header">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Works', href: '/works' },
          {
            label: WORK_CATEGORY_META[frontmatter.workCategory as WorkCategory].label,
            href: `/works/category/${frontmatter.workCategory}`,
          },
          { label: frontmatter.title },
        ]} />
        <CelticDivider tone="forest" class="breadcrumb-divider" />
        <h1>{frontmatter.title}</h1>
      </header>
      <CelticDivider tone="forest" class="article-divider" />
      <figure class="work-cover">
        <WorkModelViewer
          src="/models/wolf.glb?v=20260811-1"
          environmentImage="/environments/monochrome_studio_02_1k.hdr"
          backgroundImage={`/model-backgrounds/${modelBackground}`}
          alt={`Interactive 3D preview for ${frontmatter.title}`}
          poster={frontmatter.cover}
        />
      </figure>
      <div class="article-content">
        <p class="work-description">{frontmatter.description}</p>
        <dl class="work-specification">
          <div>
            <dt>Material</dt>
            <dd>{frontmatter.materials.join(' / ')}</dd>
          </div>
          <div>
            <dt>Dimensions</dt>
            <dd>{frontmatter.dimensions}</dd>
          </div>
          {frontmatter.createdDate && (
            <div>
              <dt>Created</dt>
              <dd>{frontmatter.createdDate.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</dd>
            </div>
          )}
          {frontmatter.edition && (
            <div>
              <dt>Edition</dt>
              <dd>{frontmatter.edition}</dd>
            </div>
          )}
        </dl>
        <slot />
        <p class="work-shop-cta">
          {frontmatter.shopUrl ? (
            <a
              class:list={['work-shop-link', availability.className]}
              href={frontmatter.shopUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {availability.label} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class:list={['work-shop-link', availability.className]}>{availability.label}</span>
          )}
        </p>
        <SmallDivider tone="forest" class="article-ending-mark" />
      </div>
    </article>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(workSchema)} />
  </main>
</Layout>
