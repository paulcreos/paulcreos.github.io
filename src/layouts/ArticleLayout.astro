---
import Layout from './Layout.astro';
import CelticDivider from '../components/CelticDivider.astro';
import SmallDivider from '../components/SmallDivider.astro';
import { SITE } from '../config/site';
import { WORK_AVAILABILITY, type WorkAvailability } from '../data/work-availability';

const { frontmatter, slug } = Astro.props;
const availability = frontmatter.availability
  ? WORK_AVAILABILITY[frontmatter.availability as WorkAvailability]
  : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.date.toISOString(),
  dateModified: (frontmatter.updatedDate ?? frontmatter.date).toISOString(),
  author: {
    '@type': 'Person',
    name: frontmatter.author ?? SITE.author,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: `${SITE.url}/articles/${slug}`,
};
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  canonical={`/articles/${slug}`}
  type="article"
  publishedTime={frontmatter.date}
  modifiedTime={frontmatter.updatedDate}
>
  <main id="main-content" class="articles-page">
    <article class="article-shell">
      <header class="article-header">
        <h1>{frontmatter.title}</h1>
        <p class="article-meta">
          <time datetime={frontmatter.date.toISOString()}>
            {frontmatter.date.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
          {frontmatter.author && <span> · {frontmatter.author}</span>}
        </p>
      </header>
      <CelticDivider tone="forest" class="article-divider" />
      <div class="article-content">
        <slot />
        {availability && (
          <p class:list={['work-availability-note', availability.className]}>
            {availability.label}
          </p>
        )}
        {frontmatter.availability === 'available' && frontmatter.shopUrl && (
          <p class="work-shop-cta">
            <a href={frontmatter.shopUrl} target="_blank" rel="noopener noreferrer">
              View available work on Etsy <span aria-hidden="true">↗</span>
            </a>
          </p>
        )}
        <SmallDivider tone="forest" class="article-ending-mark" />
      </div>
    </article>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </main>
</Layout>
