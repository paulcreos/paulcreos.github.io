---
import Layout from '../../layouts/Layout.astro';
import ForestSpiritLayer from '../../components/forest/ForestSpiritLayer.astro';
import ArticleList from '../../components/ArticleList.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { CATEGORY_KEYS, CATEGORY_META, type Category } from '../../data/categories';
import articlesHero from '../../images/about-nemeton-hooded.jpg';

export function getStaticPaths() {
  return CATEGORY_KEYS.map((category) => ({
    params: { category },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const meta = CATEGORY_META[category];
---

<Layout title={meta.title} description={meta.description}>
  <main id="main-content" class="articles-page">
    <section class="articles-collection category-page">
      <header
        class="home-works-header articles-hero"
        style={`--articles-hero-image: url(${articlesHero.src})`}
      >
        <ForestSpiritLayer />
        <div class="articles-hero-copy">
          <h1>{meta.label}</h1>
          <p class="section-intro">{meta.description}</p>
        </div>
        <CategoryNav />
      </header>
      <div class="articles-collection-body articles-collection-body--latest">
      <ArticleList category={category} compact />
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .category-page .articles-collection-body--latest {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
  }
  .category-page .articles-collection-body--latest .article-list--compact {
    gap: 0;
  }
</style>
