---
import { Image, getImage } from 'astro:assets';
import CelticDivider from '../components/CelticDivider.astro';
import Layout from '../layouts/Layout.astro';
import ravenSigil from '../content/articles/images/raven-sigil-cover-v1.png';
import ravenSigilKnotwork from '../content/articles/images/raven-sigil-knotwork-cover-v1.png';
import wolfGuardian from '../content/articles/images/wolf-guardian-cover-v1.png';
import wolfGuardianDetail from '../content/articles/images/wolf-guardian-detail-v1.png';
import wolfGuardianMacro from '../content/articles/images/wolf-guardian-macro-v1.png';

const galleryItems = [
  {
    image: ravenSigil,
    alt: 'Circular wooden raven relief with a triskele and protective Latin inscriptions',
    caption: 'The Raven Sigil, a protective circular relief combining carving, pyrography, and symbolic detail.',
    material: 'Ash / Birch',
  },
  {
    image: ravenSigilKnotwork,
    alt: 'Circular wooden raven relief surrounded by a continuous Celtic-inspired knot border',
    caption: 'The Raven Sigil knotwork variant, framed by an unbroken interlaced border.',
    material: 'Ash / Birch',
  },
  {
    image: wolfGuardian,
    alt: 'Circular wooden relief of a snarling wolf framed by Celtic-inspired knotwork',
    caption: 'The Wolf Guardian, a carved relief shaped around strength, vigilance, and the protection of a boundary.',
    material: 'Ash / Birch',
  },
  {
    image: wolfGuardianDetail,
    alt: 'Detail of a carved wooden wolf with a chain, knot pendant, and triskele',
    caption: 'A close view of the Wolf Guardian showing the layered fur, chain, pendants, and pyrographic detail.',
    material: 'Ash / Birch',
  },
  {
    image: wolfGuardianMacro,
    alt: 'Close detail of the carved Wolf Guardian face, chain, and symbolic pendants',
    caption: 'A closer study of the Wolf Guardian revealing the hand-finished surfaces and fine pyrographic lines.',
    material: 'Ash / Birch',
  },
];

const itemsWithFullImages = await Promise.all(
  galleryItems.map(async (item) => ({
    ...item,
    fullImage: await getImage({
      src: item.image,
      width: 1024,
      format: 'webp',
      quality: 82,
    }),
  })),
);
---

<Layout
  title="Gallery"
  description="A gallery of carved wooden reliefs and hand-finished symbolic details by Paul Creos."
>
  <main id="main-content">
    <section class="content-section gallery-section" aria-labelledby="gallery-heading">
      <h1 id="gallery-heading">Gallery</h1>
      <p class="section-intro">
        Explore carved reliefs in ash and birch. Open any image for a closer view.
      </p>
      <CelticDivider tone="forest" class="gallery-divider" />

      <div class="gallery-grid">
        {itemsWithFullImages.map((item) => (
          <figure class="gallery-item">
            <a
              href={item.fullImage.src}
              data-fslightbox="creos-gallery"
              data-caption={`${item.caption} Material: ${item.material}.`}
              aria-label={`Open larger image: ${item.alt}`}
            >
              <Image
                src={item.image}
                alt={item.alt}
                widths={[320, 480, 640]}
                sizes="(min-width: 64rem) 240px, (min-width: 48rem) 50vw, 100vw"
                format="webp"
                quality={78}
                loading="lazy"
                class="gallery-image"
              />
            </a>
            <figcaption>
              <span>{item.alt}</span>
              <small>Material: {item.material}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
    <script is:inline src="/js/fslightbox.js" defer></script>
  </main>
</Layout>
