---
import Layout from '../../layouts/Layout.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import WorkCategoryNav from '../../components/WorkCategoryNav.astro';

const meta = {
  title: 'Original Handcrafted Wood Reliefs',
  description: 'Explore original wood reliefs by Paul Creos, shaped from solid timber through CNC preparation, hand carving, pyrography, and symbolic detail.',
};
---

<Layout {...meta}>
  <main id="main-content" class="works-page">
    <section class="collection-section works-section" aria-labelledby="works-heading">
      <header class="home-works-header">
      <h1 id="works-heading">Works</h1>
      <p class="section-intro">Stylised relief pictures, roundels, icons, and symbols made from solid wood.</p>
      <WorkCategoryNav />
      </header>
      <WorkGrid />
    </section>
  </main>
</Layout>
