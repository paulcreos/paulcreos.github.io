---
import Layout from '../../layouts/Layout.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import WorkCategoryNav from '../../components/WorkCategoryNav.astro';
import CelticDivider from '../../components/CelticDivider.astro';

const meta = {
  title: 'Original Handcrafted Wood Reliefs',
  description: 'Explore original wood reliefs by Paul Creos, shaped from solid timber through CNC preparation, hand carving, pyrography, and symbolic detail.',
};
---

<Layout {...meta}>
  <main id="main-content" class="works-page">
    <section class="content-section works-section" aria-labelledby="works-heading">
      <h1 id="works-heading">Works</h1>
      <p class="section-intro">Original reliefs and objects shaped in wood, symbol, hand, and fire.</p>
      <CelticDivider tone="forest" class="works-divider" />
      <WorkCategoryNav />
      <WorkGrid />
    </section>
  </main>
</Layout>
