---
import Layout from '../../../layouts/Layout.astro';
import ForestSpiritLayer from '../../../components/forest/ForestSpiritLayer.astro';
import WorkGrid from '../../../components/WorkGrid.astro';
import WorkCategoryNav from '../../../components/WorkCategoryNav.astro';
import { WORK_CATEGORY_KEYS, WORK_CATEGORY_META, type WorkCategory } from '../../../data/work-categories';
import worksHero from '../../../images/works-hero-wolf-v2.png';

export function getStaticPaths() {
  return WORK_CATEGORY_KEYS.map((category) => ({
    params: { category },
    props: { category },
  }));
}

interface Props {
  category: WorkCategory;
}

const { category } = Astro.props;
const meta = WORK_CATEGORY_META[category];
---

<Layout title={meta.title} description={meta.description}>
  <main id="main-content" class="works-page">
    <section class="collection-section works-section" aria-labelledby="works-heading">
      <header
        class="home-works-header works-hero"
        style={`--works-hero-image: url(${worksHero.src})`}
      >
        <ForestSpiritLayer subtle />
        <div class="works-hero-copy">
          <h1 id="works-heading">{meta.label}</h1>
          <p class="section-intro">{meta.description}</p>
        </div>
        <WorkCategoryNav />
      </header>
      <WorkGrid category={category} />
    </section>
  </main>
</Layout>
