---
import Layout from '../layouts/Layout.astro';
import ArticleList from '../components/ArticleList.astro';
import CategoryNav from '../components/CategoryNav.astro';
import ImageHero from '../components/ImageHero.astro';
import FollowThePath from '../components/FollowThePath.astro';
import { SITE } from '../config/site';
import homeCraftHero from '../images/home-craft-hero.jpg';
---

<Layout title={SITE.name} description={SITE.description}>
  <main id="main-content">
    <ImageHero
      image={homeCraftHero}
      alt="Hands carving an intricate circular relief from solid wood"
      motto="Imthecht in Druad"
      headingId="home-hero-heading"
      objectPosition="center"
      mobileObjectPosition="64% center"
      parallaxRange={110}
    >
      <nav class="image-hero-actions" aria-label="Explore Paul Creos">
        <a class="image-hero-action-primary" href="/category/works">Explore the works</a>
        <a href="/about">Enter the story</a>
      </nav>
    </ImageHero>

    <section class="content-section" aria-labelledby="latest-articles">
      <h2 id="latest-articles">Latest articles</h2>
      <CategoryNav />
      <ArticleList limit={3} />
    </section>

    <FollowThePath />
  </main>
</Layout>
