---
import Layout from '../layouts/Layout.astro';
import WorkGrid from '../components/WorkGrid.astro';
import WorkCategoryNav from '../components/WorkCategoryNav.astro';
import DruidIntroduction from '../components/DruidIntro.astro';
import LogoMark from '../components/LogoMark.astro';
import SliderHero from '../components/SliderHero.astro';
import ForestSpiritLayer from '../components/forest/ForestSpiritLayer.astro';
import { PAGE_META } from '../data/page-meta';
import { SITE } from '../config/site';
import heroImageUrl from '../images/about-nemeton-hooded.jpg?url';

const pageMeta = SITE.underConstruction
  ? {
      title: 'The workshop hasn’t gone silent',
      description: 'The workshop’s doors are temporarily closed while something new takes shape inside.',
    }
  : PAGE_META.home;
---

<Layout {...pageMeta} chrome={!SITE.underConstruction}>
  {SITE.underConstruction ? (
    <main
      id="main-content"
      class="under-construction"
      style={`--under-construction-image: url(${heroImageUrl})`}
    >
      <ForestSpiritLayer />
      <section class="under-construction-card" aria-labelledby="under-construction-title">
        <LogoMark class="under-construction-mark" />
        <h1 id="under-construction-title">The workshop hasn’t gone silent.</h1>
        <p class="under-construction-copy">
          Its doors are simply closed while something new takes shape inside.
          The moment the work is finished, its doors will open again.
        </p>
      </section>
    </main>
  ) : (
    <main id="main-content">
      <SliderHero />

      <div class="home-works-collection">
      <header class="home-works-header home-works-header-outside" aria-labelledby="latest-works">
        <h2 id="latest-works">Latest works</h2>
        <WorkCategoryNav />
      </header>
      <section class="content-section works-section home-works-section collection-section" aria-label="Latest works collection">
        <div class="home-works-inner">
          <WorkGrid limit={9} />
        </div>
      </section>
      </div>

      <DruidIntroduction />

    </main>
  )}
</Layout>
