---
import Layout from '../../layouts/Layout.astro';
import ArticleList from '../../components/ArticleList.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import Hero from '../../components/Hero.astro';
---

<Layout
  title="Articles"
  description="Articles by Paul Creos on craftsmanship, digital fabrication, creative technology, and modern Druidry."
>
  <main id="main-content">
    <Hero
      title="Behind the form."
      lines={['Thoughts on craftsmanship, design, and process.']}
      tone="accent"
    />

    <section class="content-section" aria-labelledby="all-articles">
      <h1 id="all-articles">All articles</h1>
      <CategoryNav />
      <ArticleList />
    </section>
  </main>
</Layout>
