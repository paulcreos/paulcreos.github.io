---
import Layout from '../../layouts/Layout.astro';
import ArticleList from '../../components/ArticleList.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import CelticDivider from '../../components/CelticDivider.astro';
---

<Layout
  title="Articles"
  description="Articles by Paul Creos on craftsmanship, digital fabrication, creative technology, and modern Druidry."
>
  <main id="main-content">
    <section class="content-section" aria-labelledby="all-articles">
      <h1 id="all-articles">Articles</h1>
      <p class="section-intro">
        Notes on craft, symbolism, wood, and the meeting of handwork with technology.
      </p>
      <CelticDivider tone="forest" class="articles-divider" />
      <CategoryNav />
      <ArticleList />
    </section>
  </main>
</Layout>
