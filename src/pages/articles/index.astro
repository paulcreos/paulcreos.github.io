---
import Layout from '../../layouts/Layout.astro';
import ArticleList from '../../components/ArticleList.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import CelticDivider from '../../components/CelticDivider.astro';
import { PAGE_META } from '../../data/page-meta';
---

<Layout {...PAGE_META.articles}>
  <main id="main-content" class="articles-page">
    <section class="content-section" aria-labelledby="all-articles">
      <h1 id="all-articles">Articles</h1>
      <p class="section-intro">
        Articles on Druidry, Wyda, symbolism, and the connections between ancient Celtic and Slavic mythology and history.
      </p>
      <CelticDivider tone="forest" class="articles-divider" />
      <CategoryNav />
      <ArticleList />
    </section>
  </main>
</Layout>
