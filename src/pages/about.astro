---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import CelticDivider from '../components/CelticDivider.astro';
import FollowThePath from '../components/FollowThePath.astro';
import { PAGE_META } from '../data/page-meta';
import aboutNemeton from '../images/about-nemeton-hooded.jpg';
import LogoMark from '../components/LogoMark.astro';
---

<Layout {...PAGE_META.about}>
  <main id="main-content">
    <header class="about-hero" aria-labelledby="about-hero-heading">
      <Image
        class="about-hero-image"
        src={aboutNemeton}
        alt="A hooded figure standing among ancient oak trees in a misty nemeton"
        widths={[768, 1280, 1774]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="about-hero-shade" aria-hidden="true"></div>
      <div class="about-hero-content">
        <p class="about-hero-eyebrow">About me</p>
        <h1 id="about-hero-heading">Between craft and spirit.</h1>
        <p>I make stylised reliefs, roundels, icons, and symbols from solid wood.</p>
      </div>
    </header>

    <section class="about-section" aria-labelledby="about-heading">
      <div class="about-intro">
        <LogoMark class="about-intro-logo" alt="Paul Creos" />
        <p class="eyebrow">About me</p>
        <h2 id="about-heading">What I make and study.</h2>
        <div class="about-copy">
          <p>
            I make stylised relief pictures, roundels, icons, and symbols from solid
            wood.
          </p>
          <p>
            I practise Druidry and Wyda. I also study ancient Celtic and Slavic
            mythology and history, with a particular interest in the connections
            between them.
          </p>
          <p>
            I use what I learn as a source for the subjects, symbols, and compositions
            in my work.
          </p>
          <p>
            My works fall into three categories: Charms are personal symbols or gifts;
            Roundels are decorative and symbolic circular relief pictures; and Icons
            are my main figurative or narrative works.
          </p>
        </div>
      </div>

      <CelticDivider class="about-manifest-ornament about-manifest-ornament-top" />

      <blockquote class="about-manifest">
        <p>I turn intention into matter — and matter into meaning.</p>
      </blockquote>

      <CelticDivider class="about-manifest-ornament about-manifest-ornament-bottom" />

    </section>

    <FollowThePath />
  </main>
</Layout>

<script>
  const aboutHero = document.querySelector<HTMLElement>('.about-hero-content');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (aboutHero && !reduceMotion.matches) {
    const title = aboutHero.querySelector<HTMLElement>('h1');

    if (title) {
      const words = title.textContent?.trim().split(/\s+/) ?? [];
      title.textContent = '';
      title.classList.add('hero-title-words');

      words.forEach((word, index) => {
        const wordElement = document.createElement('span');
        wordElement.className = 'hero-title-word';
        wordElement.textContent = word;
        wordElement.style.setProperty('--word-index', String(index));
        title.append(wordElement, document.createTextNode(' '));
      });

      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => title.classList.add('is-revealed'));
      });
    }
  }
</script>
