---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import CelticDivider from '../components/CelticDivider.astro';
import FollowThePath from '../components/FollowThePath.astro';
import { PAGE_META } from '../data/page-meta';
import aboutNemeton from '../images/about-nemeton-hooded.jpg';
import LogoMark from '../components/LogoMark.astro';
---

<Layout {...PAGE_META.about}>
  <main id="main-content">
    <header class="about-hero" aria-labelledby="about-hero-heading">
      <Image
        class="about-hero-image"
        src={aboutNemeton}
        alt="A hooded figure standing among ancient oak trees in a misty nemeton"
        widths={[768, 1280, 1774]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="about-hero-shade" aria-hidden="true"></div>
      <div class="about-hero-content">
        <p class="about-hero-eyebrow">The druid’s path</p>
        <h1 id="about-hero-heading">Between craft and spirit.</h1>
        <p>My work begins where material, symbol, and inner experience meet.</p>
      </div>
    </header>

    <section class="about-section" aria-labelledby="about-heading">
      <div class="about-intro">
        <LogoMark class="about-intro-logo" alt="Paul Creos" />
        <p class="eyebrow">About me</p>
        <h2 id="about-heading">Made slowly. Made with intention.</h2>
        <div class="about-copy">
          <p>
            I am Paul Creos. My work is part of a personal path I call{' '}
            <em>Imthecht in Druad</em> — a journey between inner intention and the
            world that can be touched.
          </p>
          <p>
            I create original reliefs and objects from solid wood, drawing on nature,
            the memory held within trees, ancient ornament, and the quiet language of
            symbols. Gaelic and Slavic traditions meet here as sources of personal
            inspiration rather than fixed boundaries.
          </p>
          <p>
            Each work begins with CNC shaping, then passes into my hands. I refine the
            form with Mikisyo chisels, deepen its character through Razertip
            pyrography, and finish the surface with Osmo to preserve the warmth and
            natural presence of the wood.
          </p>
          <p>
            The machine establishes the path. The hand gives it rhythm, variation,
            and life. Through stillness and repetition, an inner idea becomes a
            physical form — something that carries both light and shadow.
          </p>
        </div>
      </div>

      <CelticDivider class="about-manifest-ornament about-manifest-ornament-top" />

      <blockquote class="about-manifest">
        <p>I turn intention into matter — and matter into meaning.</p>
      </blockquote>

      <CelticDivider class="about-manifest-ornament about-manifest-ornament-bottom" />

      <div class="process-line" aria-label="Creative process">
        <span>Wood</span>
        <span aria-hidden="true">·</span>
        <span>CNC</span>
        <span aria-hidden="true">·</span>
        <span>Chisels</span>
        <span aria-hidden="true">·</span>
        <span>Fire</span>
        <span aria-hidden="true">·</span>
        <span>Finish</span>
      </div>
    </section>

    <FollowThePath />
  </main>
</Layout>

<script>
  const aboutHero = document.querySelector<HTMLElement>('.about-hero-content');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (aboutHero && !reduceMotion.matches) {
    const title = aboutHero.querySelector<HTMLElement>('h1');

    if (title) {
      const words = title.textContent?.trim().split(/\s+/) ?? [];
      title.textContent = '';
      title.classList.add('hero-title-words');

      words.forEach((word, index) => {
        const wordElement = document.createElement('span');
        wordElement.className = 'hero-title-word';
        wordElement.textContent = word;
        wordElement.style.setProperty('--word-index', String(index));
        title.append(wordElement, document.createTextNode(' '));
      });

      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => title.classList.add('is-revealed'));
      });
    }
  }
</script>
